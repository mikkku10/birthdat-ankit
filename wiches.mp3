<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Happy Birthday Mokash Ke Daddy ❤️</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Great+Vibes&display=swap"
    rel="stylesheet">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      font-family: 'Outfit', sans-serif;
      color: white;
      overflow-x: hidden;

      background:
        radial-gradient(circle at top left, #ff758f, transparent 30%),
        radial-gradient(circle at bottom right, #c9184a, transparent 30%),
        linear-gradient(135deg, #2b0010, #590d22, #800f2f);
    }

    .celebration-container {
      position: relative;
      min-height: 100vh;
      overflow: hidden;
    }

    /* BALLOONS */

    .balloons-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 0;
    }

    .balloon {
      position: absolute;
      bottom: -150px;
      border-radius: 50%;
      opacity: .7;
    }

    .balloon::after {
      content: "";
      position: absolute;
      width: 1px;
      height: 100px;
      background: rgba(255,255,255,.5);
      left: 50%;
      top: 98%;
    }

    /* MAIN CARD */

    .content-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
      padding: 60px 20px 30px;
    }

    .glass-card {
      width: min(1100px, 95%);
      margin: auto;

      display: grid;
      grid-template-columns: 1fr 1fr;

      background: rgba(255,255,255,.09);
      border: 1px solid rgba(255,255,255,.2);

      backdrop-filter: blur(18px);

      border-radius: 35px;
      overflow: hidden;

      box-shadow: 0 30px 80px rgba(0,0,0,.35);
    }

    /* IMAGE */

    .photo-section {
      min-height: 550px;
      padding: 25px;
      display: flex;
      align-items: center;
    }

    .image-reveal {
      position: relative;
      width: 100%;
      height: 500px;
      border-radius: 25px;
      overflow: hidden;

      box-shadow: 0 20px 50px rgba(0,0,0,.35);
    }

    .main-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .image-shimmer {
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          120deg,
          transparent 30%,
          rgba(255,255,255,.3),
          transparent 70%
        );

      transform: translateX(-100%);
      animation: shimmer 4s infinite;
    }

    @keyframes shimmer {

      0% {
        transform: translateX(-100%);
      }

      50%,100% {
        transform: translateX(100%);
      }

    }

    /* MESSAGE */

    .message-section {
      padding: 60px 45px;

      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .celebrate-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.5rem,5vw,4.5rem);
      line-height: 1.05;
      margin-bottom: 30px;
    }

    .celebrate-title span {
      font-family: 'Great Vibes', cursive;
      color: #ffb3c1;

      text-shadow:
        0 5px 20px rgba(255,117,143,.5);
    }

    .message-content {
      font-size: 1.1rem;
      line-height: 1.8;
      color: #ffe5eb;
    }

    .reveal-p {
      margin-bottom: 15px;
    }

    /* BUTTON */

    .add-btn {
      margin-top: 15px;

      border: none;
      cursor: pointer;

      padding: 14px 25px;

      border-radius: 50px;

      color: white;

      font-family: 'Outfit';
      font-size: 1rem;
      font-weight: 600;

      background:
        linear-gradient(
          135deg,
          #ff4d6d,
          #c9184a
        );

      box-shadow:
        0 10px 30px rgba(255,77,109,.35);

      transition: .3s;
    }

    .add-btn:hover {
      transform: translateY(-3px) scale(1.03);
    }

    /* FOOTER */

    .footer-info {
      margin-top: 40px;

      display: flex;
      justify-content: space-between;
      align-items: center;

      gap: 15px;
      flex-wrap: wrap;
    }

    .credit {
      color: #ffdce4;
      font-size: .9rem;
    }

    .author {
      font-family: 'Great Vibes';
      font-size: 1.4rem;
      color: #ffb3c1;
    }

    .heart-pulse {
      color: #ff4d6d;
      animation: heartbeat 1.2s infinite;
      display: inline-block;
    }

    @keyframes heartbeat {

      0%,100% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.3);
      }

    }

    .back-home {
      color: white;
      text-decoration: none;

      padding: 8px 15px;

      border: 1px solid rgba(255,255,255,.3);

      border-radius: 30px;
    }

    /* =====================
       CAKE SECTION
    ===================== */

    .cake-section {
      position: relative;
      z-index: 3;

      width: min(950px,94%);

      margin: 60px auto 80px;

      padding: 45px 25px;

      text-align: center;

      background: rgba(255,255,255,.08);

      border:
        1px solid rgba(255,255,255,.18);

      backdrop-filter: blur(15px);

      border-radius: 35px;

      box-shadow:
        0 25px 70px rgba(0,0,0,.35);
    }

    .cake-title {
      font-family: 'Playfair Display';

      font-size:
        clamp(1.8rem,4vw,3rem);

      margin-bottom: 10px;
    }

    .cake-title span {
      display: block;

      font-family: 'Great Vibes';

      color: #ffb3c1;

      font-size:
        clamp(2.5rem,6vw,4rem);

      text-shadow:
        0 5px 25px rgba(255,77,109,.6);
    }

    .cake-subtitle {
      color: #ffdce4;
      margin-bottom: 30px;
    }

    /* VIDEO */

    .cake-video-wrapper {
      position: relative;

      max-width: 800px;

      margin: auto;

      padding: 8px;

      border-radius: 28px;

      background:
        linear-gradient(
          135deg,
          #ff4d6d,
          #ffb3c1,
          #c9184a
        );

      box-shadow:
        0 20px 60px rgba(255,77,109,.35);
    }

    .cake-video {
      display: block;

      width: 100%;

      max-height: 550px;

      border-radius: 21px;

      background: #140006;

      object-fit: contain;
    }

    /* NAME OVER VIDEO */

    .cake-name {
      position: absolute;

      left: 50%;
      bottom: 30px;

      transform: translateX(-50%);

      width: 85%;

      padding: 12px 20px;

      border-radius: 50px;

      font-family: 'Great Vibes';

      font-size:
        clamp(1.8rem,5vw,3rem);

      color: white;

      background:
        rgba(60,0,20,.5);

      backdrop-filter: blur(8px);

      border:
        1px solid rgba(255,255,255,.25);

      text-shadow:
        0 3px 15px #ff1744;

      animation:
        nameGlow 2s infinite alternate;
    }

    @keyframes nameGlow {

      from {
        box-shadow:
          0 0 10px rgba(255,117,143,.2);
      }

      to {
        box-shadow:
          0 0 30px rgba(255,117,143,.6);
      }

    }

    /* WISH TEXT */

    .cake-message {
      margin-top: 28px;

      line-height: 1.8;

      color: #ffe5eb;

      font-size: 1.1rem;
    }

    .love-line {
      font-family: 'Great Vibes';

      font-size: 2rem;

      color: #ffb3c1;
    }

    /* VOICE MESSAGE BUTTON */

    .voice-box {
      margin: 30px auto 0;

      max-width: 600px;

      padding: 20px;

      border-radius: 20px;

      background:
        rgba(255,255,255,.08);

      border:
        1px solid rgba(255,255,255,.15);
    }

    .voice-title {
      font-family: 'Great Vibes';

      font-size: 2rem;

      color: #ffb3c1;

      margin-bottom: 12px;
    }

    .voice-btn {
      border: none;

      cursor: pointer;

      padding: 13px 25px;

      border-radius: 50px;

      color: white;

      font-size: 1rem;

      background:
        linear-gradient(
          135deg,
          #ff758f,
          #c9184a
        );

      box-shadow:
        0 10px 30px rgba(255,77,109,.3);

      transition: .3s;
    }

    .voice-btn:hover {
      transform: scale(1.05);
    }

    .voice-btn.playing {
      animation:
        voicePulse 1s infinite;
    }

    @keyframes voicePulse {

      0%,100% {
        box-shadow:
          0 0 10px #ff4d6d;
      }

      50% {
        box-shadow:
          0 0 35px #ff4d6d;
      }

    }

    /* HEARTS */

    .heart {
      position: fixed;

      bottom: -50px;

      z-index: 5;

      pointer-events: none;

      font-size: 25px;

      animation:
        floatHeart linear forwards;
    }

    @keyframes floatHeart {

      0% {
        transform:
          translateY(0)
          scale(.5);

        opacity: 0;
      }

      20% {
        opacity: 1;
      }

      100% {
        transform:
          translateY(-110vh)
          translateX(var(--move))
          scale(1.3);

        opacity: 0;
      }

    }

    /* MUSIC */

    .music-controls {
      position: fixed;

      right: 25px;
      bottom: 25px;

      z-index: 100;
    }

    .fab-music {
      width: 60px;
      height: 60px;

      border: none;

      border-radius: 50%;

      cursor: pointer;

      font-size: 1.5rem;

      color: white;

      background:
        linear-gradient(
          135deg,
          #ff4d6d,
          #c9184a
        );

      box-shadow:
        0 10px 30px rgba(0,0,0,.35);
    }

    .fab-music.playing {
      animation:
        musicPulse 1s infinite;
    }

    @keyframes musicPulse {

      0%,100% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.12);
      }

    }

    /* MOBILE */

    @media(max-width:800px) {

      .content-wrapper {
        padding-top: 25px;
      }

      .glass-card {
        grid-template-columns: 1fr;
      }

      .photo-section {
        min-height: auto;
        padding: 15px;
      }

      .image-reveal {
        height: 400px;
      }

      .message-section {
        padding: 40px 25px;
      }

      .celebrate-title {
        font-size: 3rem;
      }

    }

    @media(max-width:500px) {

      .image-reveal {
        height: 330px;
      }

      .celebrate-title {
        font-size: 2.5rem;
      }

      .cake-name {
        font-size: 1.7rem;
        bottom: 15px;
      }

      .fab-music {
        width: 52px;
        height: 52px;
      }

    }

  </style>
</head>


<body>

<div class="celebration-container">

  <!-- BALLOONS -->

  <div
    class="balloons-bg"
    id="balloons-container">
  </div>


  <!-- MAIN CARD -->

  <main class="content-wrapper">

    <div class="glass-card">

      <!-- PHOTO -->

      <div class="photo-section">

        <div class="image-reveal">

          <img
            src="./img/image.png"
            alt="Birthday"
            class="main-image">

          <div class="image-shimmer"></div>

        </div>

      </div>


      <!-- MESSAGE -->

      <div class="message-section">

        <h1 class="celebrate-title">

          Happy Birthday,

          <br>

          <span>
            My Love ❤️
          </span>

        </h1>


        <div class="message-content">

          <p class="reveal-p">
            Having you in my life makes me feel like
            the luckiest person alive. ❤️
          </p>

          <p class="reveal-p">
            Your smile, your love, your presence —
            they complete my world. 🥰
          </p>

          <p class="reveal-p">
            On your special day, I wish all your dreams
            come true. May your life always be filled
            with love and happiness. 💖
          </p>

        </div>


        <button
          id="add-wish"
          class="add-btn">

          ✨ Add a Special Wish

        </button>


        <div class="footer-info">

          <div class="credit">

            Made with
            <span class="heart-pulse">❤</span>
            by

            <span class="author">
              Chavi ki Mummy
            </span>

          </div>

          <a
            href="index.html"
            class="back-home">

            Back to start

          </a>

        </div>

      </div>

    </div>

  </main>


  <!-- =========================
       CAKE CUTTING
  ========================== -->

  <section class="cake-section">

    <h2 class="cake-title">

      🎂 A Special Cake For

      <span>
        Mokash Ke Daddy ❤️
      </span>

    </h2>


    <p class="cake-subtitle">

      Chavi ki Mummy ki taraf se
      ek special birthday surprise... 💕

    </p>


    <!-- VIDEO -->

    <div class="cake-video-wrapper">

      <video
        id="cake-video"
        class="cake-video"
        controls
        playsinline
        preload="metadata">

        <source
          src="./cake-cutting.mp4"
          type="video/mp4">

        Your browser does not support video.

      </video>


      <div class="cake-name">

        🎂 Mokash Ke Daddy ❤️

      </div>

    </div>


    <!-- MESSAGE -->

    <p class="cake-message">

      🎉 Happy Birthday Mokash Ke Daddy! 🎉

      <br>

      <span class="love-line">

        You are my today,
        my tomorrow & my forever. ❤️

      </span>

      <br>

      Chavi ki Mummy ki taraf se
      aapko bahut saari birthday wishes. 🥰

    </p>


    <!-- VOICE MESSAGE -->

    <div class="voice-box">

      <div class="voice-title">

        💌 Special Voice Message

      </div>


      <p style="margin-bottom:15px;color:#ffe5eb;">

        Chavi ki Mummy ki taraf se
        aapke liye ek special message ❤️

      </p>


      <button
        id="voice-btn"
        class="voice-btn">

        🎙️ Play Birthday Wishes

      </button>


      <!--
        IMPORTANT:
        wishes.mp3 ko same folder mein rakhein.
      -->

      <audio
        id="wish-audio"
        preload="auto">

        <source
          src="./wishes.mp3"
          type="audio/mpeg">

      </audio>

    </div>

  </section>


  <!-- MUSIC -->

  <div class="music-controls">

    <audio
      id="celebration-music"
      loop>

      <source
        src="./bsong.mpeg"
        type="audio/mpeg">

    </audio>


    <button
      id="music-toggle"
      class="fab-music">

      🎵

    </button>

  </div>

</div>


<script>

document.addEventListener(
  "DOMContentLoaded",
  () => {


  /* =====================
     ENTRANCE ANIMATION
  ===================== */

  const tl = gsap.timeline();

  tl.from(".glass-card", {

    y:100,
    opacity:0,

    duration:1.2,

    ease:"power4.out"

  })

  .from(".main-image", {

    scale:1.2,
    opacity:0,

    duration:1,

    ease:"power2.out"

  },"-=.5")

  .from(".celebrate-title", {

    x:50,
    opacity:0,

    duration:.8

  },"-=.3")

  .from(".reveal-p", {

    y:20,
    opacity:0,

    stagger:.3,

    duration:.8

  });


  /* =====================
     BALLOONS
  ===================== */

  const balloonContainer =
    document.getElementById(
      "balloons-container"
    );

  const colors = [
    "#ff4d6d",
    "#ff758f",
    "#ffb3c1",
    "#ff85a1",
    "#fbc4ab"
  ];


  for(let i=0;i<18;i++){

    const balloon =
      document.createElement("div");

    balloon.className =
      "balloon";

    const size =
      Math.random()*30+30;

    balloon.style.left =
      Math.random()*100+"%";

    balloon.style.width =
      size+"px";

    balloon.style.height =
      size*1.25+"px";

    balloon.style.backgroundColor =
      colors[
        Math.floor(
          Math.random()*colors.length
        )
      ];

    balloonContainer.appendChild(
      balloon
    );


    gsap.to(balloon, {

      y:
        -window.innerHeight-250,

      x:
        "+="+(
          Math.random()*160-80
        ),

      rotation:
        Math.random()*50-25,

      duration:
        Math.random()*10+10,

      delay:
        Math.random()*8,

      repeat:-1,

      ease:"none"

    });

  }


  /* =====================
     HEARTS
  ===================== */

  function createHeart(){

    const heart =
      document.createElement("div");

    heart.className =
      "heart";

    heart.innerHTML =
      [
        "❤️",
        "💕",
        "💖",
        "💗",
        "💓"
      ][
        Math.floor(
          Math.random()*5
        )
      ];

    heart.style.left =
      Math.random()*100+"%";

    heart.style.setProperty(
      "--move",
      Math.random()*200-100+"px"
    );

    heart.style.animationDuration =
      Math.random()*5+6+"s";

    document.body.appendChild(
      heart
    );


    setTimeout(
      () => heart.remove(),
      12000
    );

  }


  setInterval(
    createHeart,
    1300
  );


  /* =====================
     CONFETTI
  ===================== */

  const duration =
    15000;

  const animationEnd =
    Date.now()+duration;


  const defaults = {

    startVelocity:30,

    spread:360,

    ticks:60,

    zIndex:10

  };


  function randomInRange(
    min,
    max
  ){

    return Math.random()*
      (max-min)+min;

  }


  const confettiInterval =
    setInterval(
      () => {

        const timeLeft =
          animationEnd -
          Date.now();


        if(timeLeft<=0){

          clearInterval(
            confettiInterval
          );

          return;

        }


        const particleCount =
          50*
          (timeLeft/duration);


        confetti(
          Object.assign(
            {},
            defaults,
            {

              particleCount,

              origin:{

                x:
                  randomInRange(
                    .1,.3
                  ),

                y:
                  Math.random()-.2

              }

            }
          )
        );


        confetti(
          Object.assign(
            {},
            defaults,
            {

              particleCount,

              origin:{

                x:
                  randomInRange(
                    .7,.9
                  ),

                y:
                  Math.random()-.2

              }

            }
          )
        );


      },
      250
    );


  /* =====================
     SPECIAL WISH
  ===================== */

  const wishBtn =
    document.getElementById(
      "add-wish"
    );


  wishBtn.addEventListener(
    "click",
    () => {

      confetti({

        particleCount:300,

        spread:160,

        origin:{
          y:.65
        },

        zIndex:1000

      });


      for(
        let i=0;
        i<25;
        i++
      ){

        setTimeout(
          createHeart,
          i*100
        );

      }


      wishBtn.innerHTML =
        "💖 Wish Sent to the Universe!";


      setTimeout(
        () => {

          wishBtn.innerHTML =
            "✨ Add a Special Wish";

        },
        3000
      );

    }
  );


  /* =====================
     BACKGROUND MUSIC
  ===================== */

  const musicBtn =
    document.getElementById(
      "music-toggle"
    );

  const music =
    document.getElementById(
      "celebration-music"
    );

  let musicPlaying =
    false;


  musicBtn.addEventListener(
    "click",
    async () => {

      try{

        if(!musicPlaying){

          await music.play();

          musicPlaying=true;

          musicBtn.innerHTML =
            "⏸️";

          musicBtn.classList.add(
            "playing"
          );

        }

        else{

          music.pause();

          musicPlaying=false;

          musicBtn.innerHTML =
            "🎵";

          musicBtn.classList.remove(
            "playing"
          );

        }

      }

      catch(error){

        alert(
          "Music file nahi mili. bsong.mpeg check karein."
        );

      }

    }
  );


  /* =====================
     VOICE MESSAGE
  ===================== */

  const voiceBtn =
    document.getElementById(
      "voice-btn"
    );

  const wishAudio =
    document.getElementById(
      "wish-audio"
    );


  voiceBtn.addEventListener(
    "click",
    async () => {

      try{

        if(wishAudio.paused){

          /*
            Background music ko
            temporarily pause karein.
          */

          music.pause();


          await wishAudio.play();


          voiceBtn.innerHTML =
            "🔊 Birthday Wishes Playing...";

          voiceBtn.classList.add(
            "playing"
          );


          /* Hearts */

          for(
            let i=0;
            i<20;
            i++
          ){

            setTimeout(
              createHeart,
              i*150
            );

          }

        }

        else{

          wishAudio.pause();

          voiceBtn.innerHTML =
            "🎙️ Play Birthday Wishes";

          voiceBtn.classList.remove(
            "playing"
          );

        }

      }

      catch(error){

        alert(
          "wishes.mp3 file nahi mili. Please file ko HTML ke same folder mein rakhein."
        );

      }

    }
  );


  /* =====================
     VOICE FINISHED
  ===================== */

  wishAudio.addEventListener(
    "ended",
    () => {

      voiceBtn.innerHTML =
        "🎙️ Play Birthday Wishes";

      voiceBtn.classList.remove(
        "playing"
      );


      confetti({

        particleCount:250,

        spread:150,

        origin:{
          y:.6
        },

        zIndex:1000

      });


      for(
        let i=0;
        i<30;
        i++
      ){

        setTimeout(
          createHeart,
          i*100
        );

      }

    }
  );


  /* =====================
     CAKE VIDEO PLAY
  ===================== */

  const cakeVideo =
    document.getElementById(
      "cake-video"
    );


  cakeVideo.addEventListener(
    "play",
    () => {

      for(
        let i=0;
        i<15;
        i++
      ){

        setTimeout(
          createHeart,
          i*150
        );

      }

    }
  );


  /* =====================
     VIDEO END
  ===================== */

  cakeVideo.addEventListener(
    "ended",
    () => {

      confetti({

        particleCount:350,

        spread:160,

        origin:{
          y:.6
        },

        zIndex:1000

      });


      for(
        let i=0;
        i<30;
        i++
      ){

        setTimeout(
          createHeart,
          i*100
        );

      }

    }
  );

});

</script>

</body>
</html>
